# ============================================================
# Root .env — used for docker-compose.yml variable interpolation
# and as the `backend` service's env_file.
#
# Replace every CHANGE_ME value before running `docker compose up`.
# Never commit this file — add `.env` to .gitignore.
# ============================================================

# ------------------------------------------------------------
# Backend app
# ------------------------------------------------------------
NODE_ENV=production
BACKEND_PORT=3000

# ------------------------------------------------------------
# PostgreSQL — admin/superuser role (used by the postgres
# container itself, and by init scripts in ./database/init)
# ------------------------------------------------------------
POSTGRES_DB=myapp
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ------------------------------------------------------------
# PostgreSQL — role the backend service authenticates as.
# This role must be created by a script in ./database/init/
# (POSTGRES_USER above only creates the admin role).
# ------------------------------------------------------------
BACKEND_DB_USER=backend_service
BACKEND_DB_PASSWORD=CHANGE_ME_backend_password