# ============================================================
# Application
# ============================================================

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Options: development, staging, production
APP_ENV=production

# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ============================================================
# PostgreSQL
# ============================================================

# Role name must match the role created in database/init/01_create_roles.sql
DATA_SERVICE_DATABASE_URL=postgresql+psycopg://data_service:CHANGE_ME_DATA_PASSWORD@postgres:5432/hackathon1

DATA_SERVICE_DB_POOL_SIZE=10
DATA_SERVICE_DB_MAX_OVERFLOW=20


# ============================================================
# Ollama
# ============================================================

OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=CHANGE_ME_OLLAMA_MODEL
# Model must be pulled into the ollama container first:
#   docker compose exec ollama ollama pull <model>


# ============================================================
# Scraper
# ============================================================

SCRAPER_CONCURRENCY=1
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_MAX_RETRIES=3

# Delay between requests, in seconds
SCRAPER_MIN_DELAY=1
SCRAPER_MAX_DELAY=3


# ============================================================
# Camoufox
# ============================================================

# Must be true inside Docker — no display server available in the container.
# Only set false for local (non-container) debugging.
CAMOUFOX_HEADLESS=true

# Optional:
# CAMOUFOX_LOCALE=en-US
# CAMOUFOX_TIMEZONE=UTC


# ============================================================
# Processing
# ============================================================

PROCESSING_BATCH_SIZE=100


# ============================================================
# Security
# ============================================================

# Generate strong random values for anything you actually use.
# Do not commit real secrets to Git.