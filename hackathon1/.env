# Copy to .env and fill in real values. Never commit the real .env.

# ---- Postgres (admin / superuser) ----
POSTGRES_DB=appdb
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=change-me

# ---- Backend's own DB role (created on first boot by database/init) ----
BACKEND_DB_USER=backend_app
BACKEND_DB_PASSWORD=change-me

# ---- data_service's own DB role (created on first boot by database/init) ----
DATA_SERVICE_DB_USER=data_service_app
DATA_SERVICE_DB_PASSWORD=change-me

# ---- App ports / misc ----
NODE_ENV=production
BACKEND_PORT=3000


# Leave blank in production (nginx proxies /api/* to the backend container).
# Only set this if the frontend and backend are hosted on different origins.
VITE_API_BASE_URL=
