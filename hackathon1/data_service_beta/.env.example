# data_service_beta doesn't need its own .env in docker-compose — it reads
# the same DATA_SERVICE_DB_USER / DATA_SERVICE_DB_PASSWORD / POSTGRES_DB
# variables already defined in the project's root .env, via the environment:
# block you add to docker-compose.yaml (see README.md in this folder).
#
# This file just documents what main.py actually reads, for when you're
# running it outside Docker (e.g. `python main.py` on your own machine
# while iterating on a scraper).

DATABASE_URL=postgresql://user:password@localhost:5432/dbname

RUN_ONCE=true
POLL_INTERVAL_SECONDS=120
MIN_PROFIT_PERCENT=0
MATCH_TIME_TOLERANCE_MINUTES=30
